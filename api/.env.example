PORT=4000
MYSQL_URL=mysql://usuario:clave@localhost:3306/semit
# Produccion: dominios exactos separados por coma. Desarrollo local: dejar vacio con NODE_ENV!=production
CORS_ORIGIN=https://semit.org,https://www.semit.org
SYNC_ON_BOOT=0
ADMIN_USER=admin
ADMIN_PIN=cambia-este-pin-largo-y-unico
# Token para sync automatizado (header x-sync-token). Si se define, tambien autoriza writes.
SYNC_TOKEN=cambia-este-token-largo-y-unico
NODE_ENV=production
# Solo desarrollo local: ALLOW_OPEN_DEV=1 + NODE_ENV=development|test + SIN credenciales permite writes sin token. En produccion siempre 401.
ALLOW_OPEN_DEV=0
# Horas de validez de sesion admin (memoria y limpieza DB). Max 720.
SESSION_TTL_HOURS=168
# Poner en 0 para rechazar hashes legacy sha256 (solo scrypt s1$).
ALLOW_LEGACY_HASH=1
UPLOAD_IMAGE_MAX_MB=12
UPLOAD_VIDEO_MAX_MB=100
UPLOAD_JSON_MAX_MB=10
# Base del portal para sync de cursos (sin barra final). Debe apuntar al portal real.
PORTAL_API_URL=https://demo.casa-peniel.com
